PORT=5000
# MongoDB Atlas connection string (Atlas > Connect > Drivers)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/parkease?retryWrites=true&w=majority
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Comma separated list of allowed frontend origins
CLIENT_URL=http://localhost:5173
